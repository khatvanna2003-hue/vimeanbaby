# =============================================================================
# LOCAL only (Docker Postgres / pgAdmin) — SPRING_PROFILES_ACTIVE=dev
# Production Neon credentials live in .env.production (never commit) or Railway.
# Cloudinary is shared for local + production.
# =============================================================================

# Database — local Postgres
DB_URL=jdbc:postgresql://localhost:5432/vimeanbaby_db
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin seed (used in Phase 2)
ADMIN_EMAIL=admin@vimeanbaby.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Vimean Baby Admin

# Cloudinary (same account for local + production)
CLOUDINARY_CLOUD_NAME=vimeanbaby
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@vimeanbaby
