# =============================================================================
# PRODUCTION — Neon Postgres + shared Cloudinary
# Copy to .env.production (gitignored) or set the same keys on Railway.
# Convert Neon URI → JDBC: postgresql:// → jdbc:postgresql:// and drop channel_binding.
# =============================================================================

SPRING_PROFILES_ACTIVE=prod
# Railway sets PORT automatically — omit SERVER_PORT on Railway
SERVER_PORT=8080

# Neon (JDBC)
DB_URL=jdbc:postgresql://ep-XXXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password

# Security — use a long random secret in real production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=https://vimeanbaby.vercel.app,https://vimeanbaby-dashboard.vercel.app,http://localhost:3000,http://localhost:3001

ADMIN_EMAIL=admin@vimeanbaby.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Vimean Baby Admin

# Same Cloudinary cloud as local
CLOUDINARY_CLOUD_NAME=vimeanbaby
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
